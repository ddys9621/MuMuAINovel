# =============================
# MuMuAINovel Docker 环境变量模板（生产）
# 复制为 .env 后按需修改
# =============================

# 基础应用
APP_NAME=MuMuAINovel
APP_VERSION=1.0.0
APP_PORT=8000
DEBUG=false
TZ=Asia/Shanghai

# 前端访问地址（用于 OAuth 回调等）
FRONTEND_URL=http://localhost:8000

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=mumuai_novel
POSTGRES_USER=mumuai
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_WAL_BUFFERS=16MB
POSTGRES_DEFAULT_STATISTICS_TARGET=100
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
POSTGRES_WORK_MEM=4MB
POSTGRES_MIN_WAL_SIZE=1GB
POSTGRES_MAX_WAL_SIZE=4GB

# 应用数据库连接串（必须配置）
# 注意：若密码包含 @ : / # 等特殊字符，需先做 URL 编码
# 示例中的密码仅占位，请替换为真实且已编码的密码
DATABASE_URL=postgresql+asyncpg://mumuai:REPLACE_WITH_URLENCODED_PASSWORD@postgres:5432/mumuai_novel

# 数据库连接池
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=True
DATABASE_POOL_USE_LIFO=True

# 代理（可选）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# AI 服务（按需填写）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

# LinuxDO OAuth（可选）
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=http://localhost:8000/api/auth/linuxdo/callback

# 本地账户
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_DISPLAY_NAME=本地管理员

# 会话配置
SESSION_EXPIRE_MINUTES=120
SESSION_REFRESH_THRESHOLD_MINUTES=30

# 重要：以下敏感信息通过 secrets 文件提供
# secrets/postgres_password.txt
# secrets/local_auth_password.txt

